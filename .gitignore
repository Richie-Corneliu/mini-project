# Python virtual environment
venv/
env/
.venv/

# Weights & Dataset
*.pt
*.onnx
*.engine
*.weights
runs/

# Video & Large Media
*.mp4
*.avi
*.mkv

# Runtime logs & audit output (keep the folder)
logs/*
!logs/.gitkeep
# daily count snapshots + archives are runtime state, never committed
logs/*.json
logs/*.tmp
logs/archive/
# live benchmark reports (manual_counter.py)
logs/benchmarks/

# Cache
__pycache__/
.vscode/

# Secrets (commit the template, never .env)
.env
!.env.example